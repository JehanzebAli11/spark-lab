# ~/.config/spark-lab.env (chmod 600), read by every spark-lab service.
# scripts/bootstrap.sh writes it from this file and asks only for NTFY_TOPIC and HF_TOKEN.

# Phone alerts via ntfy: install the ntfy app, subscribe to this topic.
# Use a long random topic; anyone who knows it can read your alerts.
NTFY_TOPIC=spark-lab-CHANGE-ME-to-something-random
NTFY_SERVER=https://ntfy.sh

# Teacher model served by vllm-teacher.service. The Hugging Face id is case-sensitive.
# Image: NVIDIA's DGX Spark vLLM playbook uses vllm/vllm-openai:gemma4-cu130 for Gemma 4 (arm64,
# CUDA 13.0); pinned by digest, verified 2026-11-03. Sources and memory maths: docs/bootstrap.md.
TEACHER_MODEL=google/gemma-4-31B-it
VLLM_IMAGE=vllm/vllm-openai:gemma4-cu130@sha256:0d152595cd940ea1e0890fa190a37b7a86e3f7f0f5048ac3e2e4c14529fea833
# Fraction of the Spark's unified memory vLLM may take. BF16 weights are ~62.5 GB, so 0.70
# (~90 GB) leaves ~25 GB for KV cache and ~38 GB for everything else.
VLLM_GPU_UTIL=0.70
TEACHER_URL=http://localhost:8000/v1

# Hugging Face READ token for downloads. The write token lives only with publish/.
HF_TOKEN=

# Nightly behaviour
LAB_STOP_AT=08:30
LAB_PROJECT_REPOS="../scam-radar ../urdu-jailbreak-bench ../cricket-shot-coach ../urdu-token-tax"
LAB_MIN_FREE_GB=50
