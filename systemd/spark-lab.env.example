# Copy to ~/.config/spark-lab.env (chmod 600). Read by every spark-lab service.

# Phone alerts via ntfy: install the ntfy app, subscribe to this topic.
# Use a long random topic; anyone who knows it can read your alerts.
NTFY_TOPIC=spark-lab-CHANGE-ME-to-something-random
NTFY_SERVER=https://ntfy.sh

# Teacher model served by vllm-teacher.service
TEACHER_MODEL=google/gemma-4-31b-it
VLLM_IMAGE=nvcr.io/nvidia/vllm:CHECK-PLAYBOOK-FOR-TAG
VLLM_GPU_UTIL=0.55

# Hugging Face READ token for downloads. The write token lives only with publish/.
HF_TOKEN=

# Nightly behaviour
LAB_STOP_AT=08:30
LAB_PROJECT_REPOS="../scam-radar ../urdu-jailbreak-bench ../cricket-shot-coach ../urdu-token-tax"
LAB_MIN_FREE_GB=50
